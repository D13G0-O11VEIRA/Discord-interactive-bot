# ===== Discord =====
DISCORD_TOKEN=SEU_TOKEN

# ===== Minecraft: servidor =====
# Endereço do servidor (com a porta, se não for 25565). Obrigatório.
MC_ADDRESS=meuservidor.aternos.me:12345
# aternos = o bot monitora e avisa (não liga sozinho) | local = servidor na mesma máquina do bot
MC_PROVIDER=aternos
# Link do painel que o botão de /mc start abre
MC_ATERNOS_URL=https://aternos.org/servers/
# Como reconhecer o "servidor de espera" do Aternos (confira com /mc raw)
#MC_OFFLINE_HINTS=offline
#MC_TRANSITION_HINTS=starting,loading,preparing,saving,stopping,queue,waiting
# Segundos entre consultas de status (mínimo 10)
MC_STATUS_INTERVAL=30
# Mostra "Minecraft • 2/20" na presença do bot
MC_UPDATE_PRESENCE=false

# ===== Avisos (também dá para definir com /mc configurar) =====
#MC_NOTIFY_CHANNEL_ID=
#MC_NOTIFY_ROLE_ID=

# ===== Servidor local (MC_PROVIDER=local e/ou MC_BRIDGE_MODE=local) =====
#MC_SERVER_DIR=C:\servidor-minecraft
#MC_START_COMMAND=java -Xmx2G -jar server.jar nogui
#MC_LOG_FILE=C:\servidor-minecraft\logs\latest.log
#MC_RCON_HOST=127.0.0.1
#MC_RCON_PORT=25575
#MC_RCON_PASSWORD=
# Libera /mc cmd (console remoto) para quem tem Gerenciar Servidor
MC_ALLOW_CONSOLE=false

# ===== Ponte de chat =====
# off | plugin (Aternos: o plugin da pasta companion/ conecta no bot) | local (log + RCON)
MC_BRIDGE_MODE=off
#MC_BRIDGE_CHANNEL_ID=
# Opcional: webhook do canal da ponte, para mostrar o nome e a skin do jogador
#MC_BRIDGE_WEBHOOK_URL=
MC_SHOW_JOINS=true
MC_SHOW_DEATHS=true
MC_SHOW_ADVANCEMENTS=false
# Só para MC_BRIDGE_MODE=plugin (token com 16+ caracteres; o mesmo vai no config.yml do plugin)
MC_WS_HOST=0.0.0.0
MC_WS_PORT=8765
#MC_WS_TOKEN=
